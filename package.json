{
  "name": "orbit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:pages": "npm run build -- --base=/orbit/",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "npm run preview -- --base=/orbit/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "A small, luminous orbital puzzle prototype.",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
